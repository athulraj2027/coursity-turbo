generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum LectureStatus {
  NOT_STARTED
  STARTED
  CANCELLED
  COMPLETED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
}

// ---------- MODELS ----------

model User { 
  id              String            @id @default(uuid())
  username        String
  email           String            @unique
  password        String
  role            Role              @default(STUDENT)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  wallet          Int               @default(0)

  studentProfile  StudentProfile?
  teacherProfile  TeacherProfile?
  adminProfile    AdminProfile? 

  participants    Participant[] 
  createdCoupons  Coupon[]          @relation("CreatedCoupons")
  redemptions     CouponRedemption[]
   walletTransactions WalletTransaction[] 
}

model StudentProfile {
  id              String            @id @default(uuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id])

  enrollments     Enrollment[]
  attendances     Attendance[]
  homeworkSubmissions HomeworkSubmission[]
  reports         StudentReport[]
}

model TeacherProfile {
  id              String            @id @default(uuid())
  userId          String            @unique
  bio             String? 
  expertise       String?  
  experience      Int?
  verifyStatus    Boolean           @default(false)
  user            User              @relation(fields: [userId], references: [id])

  courses         Course[]
  reports         TeacherReport[]
}

model AdminProfile {
  id              String            @id @default(uuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id])
}

model Otp {
  id         String   @id @default(cuid())
  email      String
  code       String
  expiresAt  DateTime
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Course {
  id              String            @id @default(uuid())
  name            String            @unique
  description     String
  price           Int
  startDate       DateTime              
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  teacherId       String
  teacher         TeacherProfile    @relation(fields: [teacherId], references: [id])
  enrollments     Enrollment[]
  lectures        Lecture[]       
  coupons         Coupon[]  
  redemptions     CouponRedemption[]
  homeworks       Homework[]
  reports         StudentReport[]
}

model Enrollment {
  id              String            @id @default(uuid())
  studentId       String
  courseId        String
  status          EnrollmentStatus  @default(ACTIVE)
  enrolledAt      DateTime          @default(now())
  noOfClassesAttended   Int         @default(0)

  student         StudentProfile    @relation(fields: [studentId], references: [id])
  course          Course            @relation(fields: [courseId], references: [id])
}

model Lecture {
  id              String          @id @default(uuid())
  courseId        String
  title           String
  startTime       DateTime
  status          LectureStatus
  meetingId       String?         @unique

  course          Course          @relation(fields: [courseId], references: [id])
  participants    Participant[]
  attendances     Attendance[]
}

model Participant {
  id              String          @id @default(uuid())
  userId          String          
  lectureId       String
  role            Role
  joinTime        DateTime        @default(now())
  leaveTime       DateTime?

  user            User            @relation(fields: [userId], references: [id])
  lecture         Lecture         @relation(fields: [lectureId], references: [id])
}

model Attendance {
  id              String          @id @default(uuid())
  lectureId       String
  studentId       String
  status          AttendanceStatus   @default(PRESENT)
  joinTime        DateTime?
  leaveTime       DateTime?
  durationMinutes Int?
  markedBy        String?
  markedAt        DateTime?

  lecture         Lecture        @relation(fields: [lectureId], references: [id])
  student         StudentProfile @relation(fields: [studentId], references: [id])
}

model Coupon {
  id             String      @id @default(uuid())
  code           String      @unique
  description    String?
  discountType   DiscountType
  discountValue  Int
  maxUses        Int?
  usedCount      Int           @default(0)
  expiresAt      DateTime
  deletedAt      DateTime?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())

  courseId       String?
  createdById    String?

  course         Course?       @relation(fields: [courseId], references: [id])
  createdBy      User?         @relation("CreatedCoupons", fields: [createdById], references: [id])
  redemptions    CouponRedemption[]
}

model CouponRedemption {
  id         String     @id @default(uuid())
  couponId   String
  userId     String
  courseId   String?
  redeemedAt DateTime   @default(now())

  coupon     Coupon     @relation(fields: [couponId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  course     Course?    @relation(fields: [courseId], references: [id])
}

// ---------- HOMEWORK SYSTEM ----------

model Homework {
  id              String          @id @default(uuid())
  courseId        String
  title           String
  description     String?
  dueDate         DateTime?
  createdAt       DateTime        @default(now())

  course          Course          @relation(fields: [courseId], references: [id])
  submissions     HomeworkSubmission[]
}

model HomeworkSubmission {
  id              String          @id @default(uuid())
  homeworkId      String
  studentId       String
  submittedAt     DateTime? 
  fileUrl         String?
  status          SubmissionStatus  @default(PENDING)
  marks           Int? 
  feedback        String? 
  gradedAt        DateTime? 

  homework        Homework          @relation(fields: [homeworkId], references: [id])
  student         StudentProfile    @relation(fields: [studentId], references: [id])
}

// ---------- REPORTING SYSTEM ----------

model StudentReport {
  id               String          @id @default(uuid())
  studentId        String
  courseId         String
  totalLectures    Int              @default(0)
  attendedLectures Int              @default(0)
  attendanceRate   Float            @default(0.0)
  avgHomeworkScore Float            @default(0.0)
  lastUpdated      DateTime         @updatedAt

  student          StudentProfile   @relation(fields: [studentId], references: [id])
  course           Course           @relation(fields: [courseId], references: [id])
}

model TeacherReport {
  id                String          @id @default(uuid())
  teacherId         String
  totalCourses      Int             @default(0)
  totalLectures     Int             @default(0)
  totalStudents     Int             @default(0)
  avgAttendanceRate Float           @default(0.0)
  avgHomeworkScore  Float           @default(0.0)
  lastUpdated       DateTime        @updatedAt

  teacher           TeacherProfile  @relation(fields: [teacherId], references: [id])
}


model WalletTransaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Int
  type        TransactionType  // CREDIT / DEBIT
  description String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

enum TransactionType {
  CREDIT
  DEBIT
}
